' Native out-of-context WinEvents; one monitor per process, on one owning thread.
Public Class DesktopEventsWindowsDesktopEvent
    Public Property EventId As Integer
    Public Property WindowHandle As Ptr
    Public Property ObjectId As Integer
    Public Property ChildId As Integer
    Public Property SourceThreadId As Integer
    Public Property EventTimeMilliseconds As Integer
End Class

Private Class DesktopEventsWindowsEventState
    Public Shared Property HookHandle As Ptr
    Public Shared Property Events As Array Of DesktopEventsWindowsDesktopEvent = []
    Public Shared Property Capacity As Integer = 256
    Public Shared Property Dropped As Integer = 0
End Class

#If TargetWindows Then
Delegate Sub DesktopEventsWindowsNativeEventCallback(hookHandle As Ptr, eventId As UInt32, windowHandle As Ptr, objectId As Int32, childId As Int32, sourceThread As UInt32, eventTime As UInt32)

' MSG is 48 bytes on Windows x64 and ARM64, including natural alignment.
Sequential Structure DesktopEventsWindowsNativeMessage
    WindowHandle As Ptr
    MessageId As UInt32
    WordParameter As UInt64
    LongParameter As Int64
    Time As UInt32
    PointX As Int32
    PointY As Int32
    PrivateValue As UInt32
End Structure

Private Optional Declare Function DesktopEventsWindowsInstallHook Lib "user32" Alias "SetWinEventHook" (firstEvent As UInt32, lastEvent As UInt32, moduleHandle As Ptr, callback As DesktopEventsWindowsNativeEventCallback, processId As UInt32, threadId As UInt32, options As UInt32) As Ptr
Private Optional Declare Function DesktopEventsWindowsRemoveHook Lib "user32" Alias "UnhookWinEvent" (hookHandle As Ptr) As Int32
Private Optional Declare Function DesktopEventsWindowsCurrentThread Lib "kernel32" Alias "GetCurrentThreadId" () As UInt32
Private Optional Declare Function DesktopEventsWindowsPeekNativeMessage Lib "user32" Alias "PeekMessageW" (ByRef message As DesktopEventsWindowsNativeMessage, windowHandle As Ptr, firstMessage As UInt32, lastMessage As UInt32, options As UInt32) As Int32
Private Optional Declare Function DesktopEventsWindowsTranslateNativeMessage Lib "user32" Alias "TranslateMessage" (ByRef message As DesktopEventsWindowsNativeMessage) As Int32
Private Optional Declare Function DesktopEventsWindowsDispatchNativeMessage Lib "user32" Alias "DispatchMessageW" (ByRef message As DesktopEventsWindowsNativeMessage) As Int64
Private Optional Declare Sub DesktopEventsWindowsRepostQuit Lib "user32" Alias "PostQuitMessage" (exitCode As Int32)

Private Sub DesktopEventsWindowsReceiveEvent(hookHandle As Ptr, eventId As UInt32, windowHandle As Ptr, objectId As Int32, childId As Int32, sourceThread As UInt32, eventTime As UInt32)
    If eventId <> 3 And eventId <> 32768 And eventId <> 32769 Then
        Exit Sub
    End If
    If eventId <> 3 And (objectId <> 0 Or childId <> 0) Then
        Exit Sub
    End If
    ' Never unwind a Buoy exception through the native callback boundary.
    Try
        If hookHandle <> DesktopEventsWindowsEventState.HookHandle Or hookHandle = Nil Then
            Exit Sub
        End If
        If Array.Count(DesktopEventsWindowsEventState.Events) >= DesktopEventsWindowsEventState.Capacity Then
            DesktopEventsWindowsEventState.Dropped += 1
            Exit Sub
        End If
        Dim entry As New DesktopEventsWindowsDesktopEvent
        entry.EventId = eventId
        entry.WindowHandle = windowHandle
        entry.ObjectId = objectId
        entry.ChildId = childId
        entry.SourceThreadId = sourceThread
        entry.EventTimeMilliseconds = eventTime
        Array.Append(DesktopEventsWindowsEventState.Events, entry)
    Catch e As Exception
        DesktopEventsWindowsEventState.Dropped += 1
    End Try
End Sub
#End If

Public Function DesktopEventsWindowsIsSupported() As Boolean
#If TargetWindows Then
    Return True
#Else
    Return False
#End If
End Function

Public Class DesktopEventsWindowsDesktopMonitor
    Private Property NativeHandle As Ptr
    Private Property OwnerThread As Integer

    ''' Default watches EVENT_SYSTEM_FOREGROUND on the current desktop.
    Public Sub Constructor(firstEvent As Integer = 3, lastEvent As Integer = 3, processId As Integer = 0, capacity As Integer = 256)
#If TargetWindows Then
        If firstEvent < 1 Or lastEvent < firstEvent Or lastEvent > 2147483647 Then
            Throw New InvalidArgumentException("WinEvent range must be ordered within 1..2147483647")
        End If
        If processId < 0 Or processId > 4294967295 Or capacity < 1 Or capacity > 65536 Then
            Throw New InvalidArgumentException("Invalid process ID or queue capacity")
        End If
        If DesktopEventsWindowsEventState.HookHandle <> Nil Then
            Throw New InvalidArgumentException("Only one DesktopEventsWindowsDesktopMonitor may be open per process")
        End If
        Me.OwnerThread = DesktopEventsWindowsCurrentThread()
        DesktopEventsWindowsEventState.Events = []
        DesktopEventsWindowsEventState.Dropped = 0
        DesktopEventsWindowsEventState.Capacity = capacity
        Me.NativeHandle = DesktopEventsWindowsInstallHook(firstEvent, lastEvent, Nil, AddressOf DesktopEventsWindowsReceiveEvent, processId, 0, 0)
        If Me.NativeHandle = Nil Then
            ' SetWinEventHook does not document a GetLastError contract.
            Throw New RuntimeException("SetWinEventHook failed")
        End If
        DesktopEventsWindowsEventState.HookHandle = Me.NativeHandle
#Else
        Throw New UnsupportedOperationException("WinDesktop requires Windows")
#End If
    End Sub

    Private Sub CheckOwner()
#If TargetWindows Then
        If Me.NativeHandle = Nil Then
            Throw New InvalidArgumentException("DesktopEventsWindowsDesktopMonitor is closed")
        End If
        If Me.OwnerThread <> DesktopEventsWindowsCurrentThread() Then
            Throw New InvalidArgumentException("DesktopEventsWindowsDesktopMonitor must be used on its creating thread")
        End If
#Else
        Throw New UnsupportedOperationException("WinDesktop requires Windows")
#End If
    End Sub

    ''' For console loops. GUI applications may use their existing message loop.
    Public Sub Pump(maxMessages As Integer = 64)
        Me.CheckOwner()
        If maxMessages < 1 Or maxMessages > 65536 Then
            Throw New InvalidArgumentException("Message limit must be within 1..65536")
        End If
#If TargetWindows Then
        For i As Integer = 1 To maxMessages
            Dim message As DesktopEventsWindowsNativeMessage
            If DesktopEventsWindowsPeekNativeMessage(message, Nil, 0, 0, 1) = 0 Then
                Exit For
            End If
            If message.MessageId = 18 Then
                DesktopEventsWindowsRepostQuit(message.WordParameter)
                Exit For
            End If
            DesktopEventsWindowsTranslateNativeMessage(message)
            DesktopEventsWindowsDispatchNativeMessage(message)
        Next
#End If
    End Sub

    Public Function DrainEvents() As Array Of DesktopEventsWindowsDesktopEvent
        Me.CheckOwner()
        Dim drained As Array Of DesktopEventsWindowsDesktopEvent = DesktopEventsWindowsEventState.Events
        DesktopEventsWindowsEventState.Events = []
        Return drained
    End Function

    Public Function DroppedEventCount() As Integer
        Me.CheckOwner()
        Return DesktopEventsWindowsEventState.Dropped
    End Function

    Public Sub Close()
#If TargetWindows Then
        If Me.NativeHandle = Nil Then
            Exit Sub
        End If
        Me.CheckOwner()
        If DesktopEventsWindowsRemoveHook(Me.NativeHandle) = 0 Then
            Throw New RuntimeException("UnhookWinEvent failed")
        End If
        DesktopEventsWindowsEventState.HookHandle = Nil
        DesktopEventsWindowsEventState.Events = []
        Me.NativeHandle = Nil
#End If
    End Sub

    Public Sub Destructor()
        ' Explicit Close is required; destruction on another thread cannot unhook.
        Try
            Me.Close()
        Catch e As Exception
            ' Native callback has static storage, so it cannot call a dead instance.
        End Try
    End Sub
End Class
